---
import CaseStudy from '../components/CaseStudy.astro';
import CrmShowcase from '../components/CrmShowcase.astro';
import { crmIntro, crmShots } from '../data/crm';
import { passion } from '../data/passion';
import { recomp } from '../data/recomp';
import { kalan } from '../data/kalan';
import { enjoy } from '../data/enjoy';
import { body } from '../data/body';

const cases = [passion, recomp, kalan, enjoy, body];
import '@fontsource-variable/inter';
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';


const email = 'michele.orecchioni@outlook.com';
const linkedin = 'https://linkedin.com/in/micheleorecchioni';

const flow = [
	{ t: 'Attrazione', d: 'Sito in Astro o WordPress, scelto in base a chi lo gestirà dopo la consegna.' },
	{ t: 'Conversione', d: 'Form e modal integrati con il CRM e con le automazioni: il contatto non si perde per strada.' },
	{ t: 'Gestione', d: 'Il contatto entra direttamente nell’anagrafica del cliente, senza inserimenti manuali.' },
	{ t: 'Nurturing', d: 'Flussi automatici, newsletter, DEM e WhatsApp sui contatti raccolti, fino alla decisione.' },
];

const stages = [
	{ id: 'siti', label: 'Sviluppo sito web' },
	{ id: 'crm', label: 'Gestione e CRM' },
	{ id: 'nurturing', label: 'Nurturing' },
];

const siteTools = ['Astro', 'WordPress', 'Elementor', 'Netlify', 'GitHub', 'SEO on-page', 'Claude Code'];
const crmTools = ['Next.js', 'TypeScript', 'Supabase', 'Vercel', 'API del gestionale', 'Claude Code'];
const nurtTools = ['Mailchimp', 'MailUp', 'Spoki', 'Canva'];

const crmRows = [
	['Pipeline commerciale', 'Assegnazione dei contatti, stati chiari e deduplica; tempo di primo ricontatto misurato sull’orario di lavoro.'],
	['Conversione', 'Monitoraggio dei passaggi da contatto a cliente, per vedere dove il percorso si interrompe.'],
	['KPI e report', 'Indicatori commerciali per persona e per periodo, confronti con lo storico e report giornaliero per la direzione.'],
	['Qualità dei dati', 'Regole di classificazione sui dati sincronizzati dal gestionale, per togliere i falsi positivi e rendere affidabili i numeri del team.'],
	['Strumenti operativi', 'Moduli pensati per il telefono per chi lavora sul campo, con utenti e inviti creati automaticamente.'],
	['Collegamento al sito', 'Form e modal scrivono direttamente nel CRM, senza passaggi a mano.'],
	['Supporto', 'Sistema di ticket interno e assistenza continua agli utenti: troubleshooting, configurazione e formazione.'],
	['Metodo di lavoro', 'Requisiti raccolti direttamente con il cliente, rilasci in piccoli passi e revisione del codice con pull request insieme a un collega sviluppatore.'],
];
const nurtRows = [
	['Flussi automatici', 'Nurturing sui contatti raccolti dai siti, agganciato al CRM del gestionale.'],
	['Newsletter e DEM', 'Le pianifico e le creo sui database dei clienti, su Mailchimp, MailUp e sul provider integrato nel gestionale.'],
	['WhatsApp', 'Campagne di direct marketing con Spoki.'],
	['Database', 'Gestisco i database dei contatti su cui partono le campagne.'],
	['Grafica', 'Realizzo in Canva i materiali delle campagne.'],
];
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#0a0c12" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		<title>Michele Orecchioni · Marketing Technologist</title>
		<meta
			name="description"
			content="Portfolio di Michele Orecchioni: siti web, gestionali e CRM, email marketing e automazioni."
		/>
		<meta property="og:title" content="Michele Orecchioni · Marketing Technologist" />
		<meta property="og:description" content="Dove il sito di un'azienda incontra il sistema che la fa funzionare." />
		<meta property="og:type" content="website" />
	</head>
	<body>
		<header class="nav">
			<div class="wrap nav-in">
				<a class="brand" href="#top">Michele Orecchioni</a>
				<nav id="menu" aria-label="Principale">
					<a href="#cosa-faccio">Cosa faccio</a>
					<a href="#siti">Sviluppo sito web</a>
					<a href="#crm">Gestione e CRM</a>
					<a href="#nurturing">Nurturing</a>
					<div class="menu-foot">
						<span>Contatti</span>
						<a href={`mailto:${email}`}>{email}</a>
						<a href={linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
					</div>
				</nav>
				<div class="actions">
					<a class="neon" href="#contatti">Contattami</a>
					<button class="burger" type="button" aria-expanded="false" aria-controls="menu" aria-label="Apri il menu">
						<span></span><span></span><span></span>
					</button>
				</div>
			</div>
		</header>

		<main id="top">
			<section class="hero">
				<div class="fx" aria-hidden="true">
					<i class="orb o1"></i>
					<i class="orb o2"></i>
					<i class="orb o3"></i>
					<div class="grid"></div>
					<div class="spot"></div>
					<div class="beam"></div>
				</div>
				<div class="wrap">
					<h1 class="reveal">
						Dove il sito incontra<br />
						<span class="grad-text">il sistema che fa funzionare l’azienda.</span>
					</h1>
					<p class="lead reveal">
						Costruisco siti web, li collego ai sistemi che li fanno funzionare (CRM, gestionali, automazioni) e presidio gli
						strumenti di marketing: email, lead nurturing e reportistica. Sono metà operativo e metà consulenziale: la persona a
						cui il cliente scrive sia quando qualcosa va costruito, sia quando qualcosa non funziona.
					</p>
					<div class="cta reveal">
						<a class="btn primary" href="#siti">Vedi i progetti</a>
						<a class="btn" href={`mailto:${email}`}>Scrivimi</a>
					</div>
				</div>
			</section>

			<section id="cosa-faccio">
				<div class="wrap">
					<header class="sec-head">
						<h2>cosa faccio</h2>
						<p>
							<span>Progetto il funnel completo, dal primo clic al cliente seguito nel tempo.</span>
						</p>
					</header>
					<div class="rail-wrap">
					<ol class="rail">
						{
							flow.map((f) => (
								<li class="reveal">
									<span class="node" aria-hidden="true" />
									<h3>{f.t}</h3>
									<p>{f.d}</p>
								</li>
							))
						}
					</ol>
					</div>
				</div>
			</section>

			<section id="siti">
				<div class="sec-fx" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
				<div class="wrap">
					<div class="mini" role="navigation" aria-label="Fase del funnel">
						{stages.map((s, k) => (
							<a href={`#${s.id}`} class:list={['st', { on: s.id === 'siti' }]} aria-current={s.id === 'siti' ? 'step' : undefined}>
								<span class="dot" aria-hidden="true" />
								<span class="nm"><b>{String(k + 1).padStart(2, '0')}</b> {s.label}</span>
							</a>
						))}
					</div>
					<header class="sec-head">
						<h2>sviluppo sito web</h2>
						<p>
							<span>Il sito è l’ingresso del funnel: qui un visitatore diventa un contatto.</span>
							<span>Lo progetto, lo sviluppo e lo mantengo io, con la tecnologia che il cliente sa gestire.</span>
						</p>
					</header>

					<div class="sites">
						{cases.map((c) => <CaseStudy data={c} />)}
					</div>
					<p class="tools">
						<b>strumenti</b>
						{siteTools.map((x, i) => (
							<>
								{i > 0 && <i>/</i>}{' '}
								{x}{' '}
							</>
						))}
					</p>
				</div>
			</section>

			<section id="crm">
				<div class="sec-fx" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
				<div class="wrap">
					<div class="mini" role="navigation" aria-label="Fase del funnel">
						{stages.map((s, k) => (
							<a href={`#${s.id}`} class:list={['st', { on: s.id === 'crm' }]} aria-current={s.id === 'crm' ? 'step' : undefined}>
								<span class="dot" aria-hidden="true" />
								<span class="nm"><b>{String(k + 1).padStart(2, '0')}</b> {s.label}</span>
							</a>
						))}
					</div>
					<header class="sec-head">
						<h2>gestione e crm</h2>
						<p>
							<span>Qui il contatto diventa un cliente: ogni richiesta arriva nel gestionale e non si perde.</span>
							<span>Lo configuro, lo collego al sito, assisto gli utenti e, dove serve, sviluppo un CRM su misura.</span>
						</p>
					</header>
					<CrmShowcase shots={crmShots} />
					<p class="tools center">
						<b>strumenti</b>
						{crmTools.map((x, i) => (
							<>
								{i > 0 && <i>/</i>}{' '}
								{x}{' '}
							</>
						))}
					</p>
					<p class="crm-claim">{crmIntro}</p>
					<dl class="ledger plain">
						{crmRows.map(([k, v]) => (
							<div class="row reveal">
								<dt>{k}</dt>
								<dd>{v}</dd>
							</div>
						))}
					</dl>
				</div>
			</section>

			<section id="nurturing">
				<div class="sec-fx" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
				<div class="wrap">
					<div class="mini" role="navigation" aria-label="Fase del funnel">
						{stages.map((s, k) => (
							<a href={`#${s.id}`} class:list={['st', { on: s.id === 'nurturing' }]} aria-current={s.id === 'nurturing' ? 'step' : undefined}>
								<span class="dot" aria-hidden="true" />
								<span class="nm"><b>{String(k + 1).padStart(2, '0')}</b> {s.label}</span>
							</a>
						))}
					</div>
					<header class="sec-head">
						<h2>nurturing</h2>
						<p>
							<span>Tiene vivo il contatto dopo la richiesta e lo accompagna fino alla decisione.</span>
							<span>Costruisco i flussi, pianifico e creo newsletter, DEM e campagne WhatsApp.</span>
						</p>
					</header>
					<dl class="ledger">
						{nurtRows.map(([k, v]) => (
							<div class="row reveal">
								<dt>{k}</dt>
								<dd>{v}</dd>
							</div>
						))}
					</dl>
					<p class="tools">
						<b>strumenti</b>
						{nurtTools.map((x, i) => (
							<>
								{i > 0 && <i>/</i>}{' '}
								{x}{' '}
							</>
						))}
					</p>
				</div>
			</section>

			<div class="closing">
				<div class="sec-fx" aria-hidden="true"><i></i><i></i><i></i><b></b></div>
			<section id="contatti">
				<div class="wrap">
					<header class="sec-head">
						<h2>contatti</h2>
						<p>
							<span>Un sito, un CRM o un flusso di nurturing: posso seguire tutto il funnel o una sola parte.</span>
							<span>Scrivimi, di solito rispondo il giorno stesso.</span>
						</p>
					</header>
					<div class="reach">
						<a class="reach-main" href={`mailto:${email}`}>
							<span class="reach-label">email</span>
							<span class="reach-value">{email.split('@')[0]}@<wbr />{email.split('@')[1]}</span>
							<span class="reach-arrow" aria-hidden="true">→</span>
						</a>
						<a class="reach-main" href={linkedin} target="_blank" rel="noopener noreferrer">
							<span class="reach-label">linkedin</span>
							<span class="reach-value">micheleorecchioni</span>
							<span class="reach-arrow" aria-hidden="true">↗</span>
						</a>
					</div>
				</div>
			</section>
			<footer>
				<div class="wrap">© {new Date().getFullYear()} Michele Orecchioni · Roma</div>
			</footer>
			</div>
		</main>


		<script>
			// blocca lo scroll senza far saltare la pagina (funziona anche su iOS)
			let lockedY = 0;
			const lockScroll = (on: boolean) => {
				const root = document.documentElement;
				if (on === root.classList.contains('menu-open')) return;
				if (on) {
					lockedY = window.scrollY;
					root.style.setProperty('--lock-y', `${-lockedY}px`);
					root.style.scrollBehavior = 'auto';
					root.classList.add('menu-open');
				} else {
					root.classList.remove('menu-open');
					window.scrollTo(0, lockedY);
					root.style.scrollBehavior = '';
				}
			};
			const header = document.querySelector('.nav');
			const burger = document.querySelector<HTMLButtonElement>('.burger');
			const setMenu = (open: boolean) => {
				header?.classList.toggle('open', open);
				lockScroll(open);
				burger?.setAttribute('aria-expanded', String(open));
				burger?.setAttribute('aria-label', open ? 'Chiudi il menu' : 'Apri il menu');
			};
			burger?.addEventListener('click', () => setMenu(!header?.classList.contains('open')));
			document.querySelectorAll<HTMLAnchorElement>('#menu a').forEach((a) =>
				a.addEventListener('click', (e) => {
					const hash = a.getAttribute('href') ?? '';
					setMenu(false);
					if (hash.startsWith('#')) {
						e.preventDefault();
						document.querySelector(hash)?.scrollIntoView({ behavior: 'smooth' });
						history.replaceState(null, '', hash);
					}
				}),
			);
			document.addEventListener('keydown', (e) => e.key === 'Escape' && setMenu(false));
			matchMedia('(min-width: 761px)').addEventListener('change', (m) => m.matches && setMenu(false));

			const hero = document.querySelector<HTMLElement>('.hero');
			const spot = document.querySelector<HTMLElement>('.spot');
			if (hero && spot && matchMedia('(hover: hover)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
				let tx = 0;
				let ty = 0;
				let x = 0;
				let y = 0;
				let started = false;
				let running = false;
				const tick = () => {
					const dx = tx - x;
					const dy = ty - y;
					x += dx * 0.09;
					y += dy * 0.09;
					const speed = Math.min(Math.hypot(dx, dy) / 90, 1);
					const angle = Math.atan2(dy, dx);
					spot.style.transform = `translate3d(${x}px, ${y}px, 0) rotate(${angle}rad) scale(${1 + speed * 0.7}, ${1 - speed * 0.3})`;
					if (Math.hypot(dx, dy) > 0.3) requestAnimationFrame(tick);
					else running = false;
				};
				hero.addEventListener('pointermove', (e) => {
					const r = hero.getBoundingClientRect();
					tx = e.clientX - r.left;
					ty = e.clientY - r.top;
					if (!started) {
						x = tx;
						y = ty;
						started = true;
					}
					spot.classList.add('live');
					if (!running) {
						running = true;
						requestAnimationFrame(tick);
					}
				});
				hero.addEventListener('pointerleave', () => spot.classList.remove('live'));
			}

			const els = document.querySelectorAll('.reveal');
			if ('IntersectionObserver' in window) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							if (e.isIntersecting) {
								e.target.classList.add('in');
								io.unobserve(e.target);
							}
						}
					},
					{ threshold: 0.12 },
				);
				els.forEach((el) => io.observe(el));
			} else {
				els.forEach((el) => el.classList.add('in'));
			}
		</script>
	</body>
</html>

<style>
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		isolation: isolate;
		border-bottom: 1px solid var(--line);
	}
	/* la sfocatura sta su uno strato a parte: un backdrop-filter sull'header
	   farebbe da contenitore al pannello fixed del menu mobile */
	.nav::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		background: rgba(10, 12, 18, 0.72);
	}
	.nav.open::before {
		background: #0a0c12;
	}
	.nav-in {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 64px;
	}
	.brand {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 0.95rem;
		text-decoration: none;
		letter-spacing: -0.01em;
		transition: text-shadow 0.25s, color 0.25s;
	}
	@media (hover: hover) {
		.brand:hover {
			color: #fff;
			text-shadow:
				0 0 4px #5ee7ff,
				0 0 14px rgba(94, 231, 255, 0.85),
				0 0 32px rgba(157, 123, 255, 0.75);
		}
	}

	/* Fascio di luce lento da sinistra a destra sull'header */
	.nav::after {
		content: '';
		position: absolute;
		inset: 0;
		pointer-events: none;
		background:
			linear-gradient(100deg, transparent, rgba(94, 231, 255, 0.1) 50%, transparent) no-repeat -40vw 0 / 40vw 100%,
			linear-gradient(90deg, transparent, rgba(94, 231, 255, 0.9) 50%, transparent) no-repeat -40vw 100% / 40vw 1px;
		animation: nav-beam 18s linear infinite;
	}
	@keyframes nav-beam {
		to {
			background-position: 140vw 0, 140vw 100%;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.nav::after {
			animation: none;
			background: none;
		}
	}
	nav {
		display: flex;
		align-items: center;
		gap: clamp(16px, 3vw, 32px);
		font-size: 0.92rem;
		margin-left: auto;
		margin-right: 24px;
	}
	nav a {
		text-decoration: none;
		color: var(--muted);
		transition: color 0.2s;
	}
	nav a:hover {
		color: #fff;
	}
	@media (hover: hover) and (min-width: 761px) {
		nav a {
			position: relative;
			padding: 6px 2px;
			transition:
				color 0.2s,
				text-shadow 0.25s;
		}
		nav a::after {
			content: '';
			position: absolute;
			left: 0;
			right: 0;
			bottom: -2px;
			height: 2px;
			border-radius: 2px;
			background: #5ee7ff;
			box-shadow:
				0 0 6px #5ee7ff,
				0 0 14px rgba(94, 231, 255, 0.8),
				0 0 26px rgba(157, 123, 255, 0.7);
			transform: scaleX(0);
			transition: transform 0.28s ease;
		}
		nav a:hover {
			text-shadow:
				0 0 4px #5ee7ff,
				0 0 14px rgba(94, 231, 255, 0.85),
				0 0 30px rgba(157, 123, 255, 0.7);
		}
		nav a:hover::after {
			transform: scaleX(1);
		}
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 10px;
	}

	/* Bottone neon */
	.neon {
		--neon: #5ee7ff;
		--neon-2: #9d7bff;
		position: relative;
		display: inline-flex;
		align-items: center;
		min-height: 42px;
		padding: 0 20px;
		border-radius: 999px;
		font-size: 0.92rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: #fff;
		background: rgba(94, 231, 255, 0.08);
		border: 1.5px solid var(--neon);
		text-shadow: 0 0 8px var(--neon);
		box-shadow:
			0 0 6px var(--neon),
			0 0 18px rgba(94, 231, 255, 0.55),
			0 0 40px rgba(157, 123, 255, 0.45),
			inset 0 0 14px rgba(94, 231, 255, 0.35);
		animation: neon-pulse 2.8s ease-in-out infinite;
		transition: transform 0.2s, background 0.2s;
	}
	.neon:hover {
		transform: translateY(-2px) scale(1.03);
		background: rgba(94, 231, 255, 0.2);
	}
	@keyframes neon-pulse {
		0%,
		100% {
			border-color: var(--neon);
			box-shadow:
				0 0 6px var(--neon),
				0 0 18px rgba(94, 231, 255, 0.55),
				0 0 40px rgba(157, 123, 255, 0.45),
				inset 0 0 14px rgba(94, 231, 255, 0.35);
		}
		50% {
			border-color: var(--neon-2);
			box-shadow:
				0 0 4px var(--neon-2),
				0 0 12px rgba(157, 123, 255, 0.5),
				0 0 28px rgba(94, 231, 255, 0.35),
				inset 0 0 8px rgba(157, 123, 255, 0.3);
		}
	}

	/* Hamburger */
	.burger {
		display: none;
		width: 44px;
		height: 44px;
		border-radius: 12px;
		border: 1px solid var(--line);
		background: var(--card);
		cursor: pointer;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		padding: 0;
	}
	.burger span {
		display: block;
		width: 20px;
		height: 2px;
		border-radius: 2px;
		background: var(--text);
		transition: transform 0.25s, opacity 0.2s;
	}
	.nav.open .burger span:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}
	.nav.open .burger span:nth-child(2) {
		opacity: 0;
	}
	.nav.open .burger span:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}
	@media (max-width: 760px) {
		.burger {
			display: flex;
		}
		nav {
			/* fisso allo schermo: si apre sempre dove si trova l'utente */
			position: fixed;
			top: 64px;
			left: 0;
			right: 0;
			height: calc(100dvh - 64px);
			margin: 0;
			flex-direction: column;
			align-items: stretch;
			justify-content: flex-start;
			gap: 0;
			padding: 20px var(--gutter) 28px;
			overflow-y: auto;
			counter-reset: m;
			background:
				radial-gradient(70% 38% at 100% 0%, rgba(124, 108, 255, 0.38), transparent 70%),
				radial-gradient(70% 34% at 0% 100%, rgba(34, 211, 238, 0.26), transparent 70%),
				radial-gradient(40% 24% at 70% 62%, rgba(255, 79, 216, 0.14), transparent 70%),
				#0a0c12;
			opacity: 0;
			visibility: hidden;
			transform: translateY(-10px);
			transition: opacity 0.3s, transform 0.3s, visibility 0.3s;
		}
		/* linea di luce che corre sotto l'header, come sul desktop */
		nav::before {
			content: '';
			position: absolute;
			top: 0;
			left: 0;
			right: 0;
			height: 1px;
			background: linear-gradient(90deg, transparent, #5ee7ff, #fff, #9d7bff, transparent) no-repeat -40% 0 / 40% 100%;
			filter: drop-shadow(0 0 6px #5ee7ff);
		}
		.nav.open nav {
			opacity: 1;
			visibility: visible;
			transform: none;
		}
		.nav.open nav::before {
			animation: menu-line 2.4s ease-in-out infinite;
		}
		@keyframes menu-line {
			to {
				background-position: 140% 0;
			}
		}
		nav > a {
			counter-increment: m;
			display: flex;
			align-items: baseline;
			gap: 16px;
			padding: 20px 0;
			font-family: var(--font-display);
			font-size: clamp(1.45rem, 7vw, 2.1rem);
			font-weight: 600;
			letter-spacing: -0.02em;
			line-height: 1.1;
			color: #fff;
			border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			opacity: 0;
			transform: translateX(-16px);
			transition:
				opacity 0.45s,
				transform 0.45s,
				color 0.2s,
				text-shadow 0.2s,
				padding-left 0.2s;
		}
		nav > a::before {
			content: '0' counter(m);
			font-family: 'Inter Variable', system-ui, sans-serif;
			font-size: 0.72rem;
			font-weight: 600;
			letter-spacing: 0.14em;
			color: #5ee7ff;
			text-shadow: 0 0 8px rgba(94, 231, 255, 0.8);
		}
		nav > a::after {
			content: '→';
			margin-left: auto;
			font-size: 1.2rem;
			color: rgba(255, 255, 255, 0.35);
			transition: transform 0.2s, color 0.2s;
		}
		.nav.open nav > a {
			opacity: 1;
			transform: none;
		}
		.nav.open nav > a:nth-child(1) {
			transition-delay: 0.08s, 0.08s, 0s, 0s, 0s;
		}
		.nav.open nav > a:nth-child(2) {
			transition-delay: 0.16s, 0.16s, 0s, 0s, 0s;
		}
		.nav.open nav > a:nth-child(3) {
			transition-delay: 0.24s, 0.24s, 0s, 0s, 0s;
		}
		.nav.open nav > a:nth-child(4) {
			transition-delay: 0.32s, 0.32s, 0s, 0s, 0s;
		}
		.nav.open nav > a:nth-child(5) {
			transition-delay: 0.4s, 0.4s, 0s, 0s, 0s;
		}
		nav > a:active {
			color: #5ee7ff;
			padding-left: 8px;
			text-shadow:
				0 0 8px rgba(94, 231, 255, 0.9),
